# sudo ./install.sh --config install.env 的答案文件。不提问，按这里的值配置。
# 复制一份再改：cp examples/install.env.example install.env && chmod 600 install.env
# 每行 KEY=值；# 开头是注释；没写的项保持不变。这个文件只会被读取，不会被执行。

# 智能体：quickstart（入门演练，不需要模型）| dsh（接真实模型）| disabled（只记录、不修）| keep（不改）
AUTOOPS_AGENT=quickstart

# 选 dsh 时填：OpenAI 兼容接口地址、模型 ID、API key
#AUTOOPS_MODEL_BASE_URL=https://api.deepseek.com/v1
#AUTOOPS_MODEL=deepseek-chat
#AUTOOPS_MODEL_API_KEY=sk-你的密钥

# 手机通知（可选）：Bark App 首页上的地址
#AUTOOPS_BARK_URL=https://api.day.app/你的设备key

# 时区（可选）。系统没有 tzdata 时写 UTC+08:00 这种固定偏移
#AUTOOPS_TIMEZONE=Asia/Shanghai
